# ─────────────────────────────────────────────────────────────
#  Frontend — Required Environment Variables
#  Copy this file to .env.local for local dev overrides.
#  For Vercel: add these in the Vercel Dashboard → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# URL of the Render backend (no trailing slash)
VITE_BACKEND_URL=https://vchat-backend-38n4.onrender.com

# Same URL — used by the Axios instance for REST API calls (/api/...)
VITE_API_URL=https://vchat-backend-38n4.onrender.com
